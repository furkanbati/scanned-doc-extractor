# Copy to .env (never commit .env).

# Required for e3 (OpenAI vision).
# OPENAI_API_KEY=

# Mode the UI and API use when a request names none (profiles.yaml).
# Default: accurate when OPENAI_API_KEY is set, else private.
# DEFAULT_PROFILE=private

# Host ports for docker compose (defaults 8000 and 8501).
# API_PORT=8000
# UI_PORT=8501
